# Server
PORT=5174
# DATA_DIR=./data
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# PYTHON_PATH=./workers/py/.venv/bin/python

# Rendering: Chromium GL backend (angle = draw on the GPU; swangle = CPU only; default = Chrome decides)
# REMOTION_GL=angle
# Parallel browser tabs per render (with GPU drawing ~3 is fastest; more tabs contend for the GPU)
# RENDER_CONCURRENCY=3

# Job concurrency per type (JSON), defaults shown
# JOB_CONCURRENCY={"transcribe":1,"proxy":2,"render":1,"faces":1}

# Transcription
# WHISPER_MODEL_GPU=large-v3-turbo
# WHISPER_MODEL_CPU=small
# WHISPER_DEVICE=auto   # auto | cuda | cpu

# LLM (optional): local CLI agents using your existing login — no API keys.
# LLM_PROVIDER = none | claude | codex
LLM_PROVIDER=none
# CLAUDE_PATH=claude
# CLAUDE_MODEL=            # empty = Claude Code's default model (e.g. sonnet, opus)
# CODEX_PATH=codex
# CODEX_MODEL=             # empty = Codex's default model
# LLM_TIMEOUT_MS=300000
